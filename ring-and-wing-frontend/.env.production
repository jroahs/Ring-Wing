# Frontend Production Environment Configuration
# This file is for Render deployment - Self-Checkout Only Mode
#
# IMPORTANT: Update VITE_API_URL with your actual Render backend URL after deployment
# Format: https://your-service-name.onrender.com

# Backend API URL (Required)
# Replace with your Render backend service URL
VITE_API_URL=https://ring-wing-backend.onrender.com

# Deployment Mode
# Options:
#   - 'self_checkout_only' = Only self-checkout routes (for customer kiosk)
#   - 'full' or empty = Full POS/admin access (for staff/admin)
# VITE_DEPLOYMENT_MODE=self_checkout_only
VITE_DEPLOYMENT_MODE=full
